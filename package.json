{
  "name": "fleetdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "simulator": "node --env-file-if-exists=.env --import tsx apps/simulator/src/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && node dist/scripts/package-eta.js && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "benchmark": "node --env-file-if-exists=.env --import tsx scripts/benchmark.ts",
    "eta:data": "node --import tsx scripts/eta-data.ts",
    "eta:train": "npm run eta:data && node --import tsx scripts/eta-train.ts",
    "eta:reproduce": "npm run eta:data && node --import tsx scripts/eta-train.ts --verify",
    "setup": "node --import tsx scripts/setup.ts",
    "demo:native": "node --env-file-if-exists=.env --import tsx scripts/stack.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.36.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
