# Generate local secrets with: npm run setup
POSTGRES_PASSWORD=replace_with_random_secret
INGEST_KEY=replace_with_a_random_32_byte_key
DEMO_MODE=true
# Local demo is interactive. Use viewer for a shared demonstration.
DEMO_ACCESS=admin
PUBLIC_ORIGIN=http://127.0.0.1:3080
COOKIE_SECURE=false
# Native development only; Compose uses its private db service.
DATABASE_URL=postgres://fleetdeck:fleetdeck_local_only@127.0.0.1:55437/fleetdeck
# Advisory ETA model. Set false to force the distance/speed baseline.
ETA_ENABLED=true
